<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anketa.MainPage"
             Title="Анкета гостя кофейни">

    <ScrollView>
        <Grid x:Name="MainGrid"
              Padding="20,16,20,32"
              RowSpacing="12"
              ColumnSpacing="12"
              RowDefinitions="Auto"
              ColumnDefinitions="Auto,*">

            <!-- Шапка -->
            <Image x:Name="LogoImage"
                   Grid.Row="0"
                   Grid.Column="0"
                   Source="coffee_cup.png"
                   Aspect="AspectFit"
                   HeightRequest="80"
                   WidthRequest="80"
                   Margin="0,0,4,0" />

            <VerticalStackLayout Grid.Row="0"
                                 Grid.Column="1"
                                 Spacing="4"
                                 VerticalOptions="Center">
                <Label x:Name="TitleLabel"
                       Text="Анкета гостя кофейни"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource CoffeeDark}" />
                <Label x:Name="SubtitleLabel"
                       Text="Помогите нам стать лучше — это займёт пару минут"
                       FontSize="14"
                       FontAttributes="Italic"
                       TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
