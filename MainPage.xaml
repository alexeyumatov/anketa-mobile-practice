<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anketa.MainPage"
             Title="Анкета гостя кофейни">

    <ScrollView>
        <Grid x:Name="MainGrid"
              Padding="20,16,20,32"
              RowSpacing="12"
              ColumnSpacing="12"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="Auto,*">

            <!-- Шапка -->
            <Image x:Name="LogoImage"
                   Grid.Row="0"
                   Grid.Column="0"
                   Source="coffee_cup.png"
                   Aspect="AspectFit"
                   HeightRequest="80"
                   WidthRequest="80"
                   Margin="0,0,4,0" />

            <VerticalStackLayout Grid.Row="0"
                                 Grid.Column="1"
                                 Spacing="4"
                                 VerticalOptions="Center">
                <Label x:Name="TitleLabel"
                       Text="Анкета гостя кофейни"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource CoffeeDark}" />
                <Label x:Name="SubtitleLabel"
                       Text="Помогите нам стать лучше — это займёт пару минут"
                       FontSize="14"
                       FontAttributes="Italic"
                       TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>

            <!-- Личные данные -->
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Личные данные"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,12,0,0"
                   TextColor="{StaticResource CoffeeDark}" />

            <Label Grid.Row="2"
                   Grid.Column="0"
                   Text="Имя *"
                   FontSize="14"
                   FontAttributes="None"
                   VerticalOptions="Center" />
            <Entry x:Name="NameEntry"
                   Grid.Row="2"
                   Grid.Column="1"
                   Placeholder="Как к вам обращаться?"
                   Keyboard="Text"
                   MaxLength="40" />

            <Label Grid.Row="3"
                   Grid.Column="0"
                   Text="Телефон *"
                   FontSize="14"
                   FontAttributes="None"
                   VerticalOptions="Center" />
            <Entry x:Name="PhoneEntry"
                   Grid.Row="3"
                   Grid.Column="1"
                   Placeholder="+7 900 000-00-00"
                   Keyboard="Telephone"
                   MaxLength="18" />

            <Label Grid.Row="4"
                   Grid.Column="0"
                   Text="Дата визита"
                   FontSize="14"
                   FontAttributes="None"
                   VerticalOptions="Center" />
            <DatePicker x:Name="VisitDatePicker"
                        Grid.Row="4"
                        Grid.Column="1"
                        Format="dd.MM.yyyy"
                        Date="10/18/2026"
                        MinimumDate="01/01/2025"
                        MaximumDate="12/31/2027" />
        </Grid>
    </ScrollView>

</ContentPage>
