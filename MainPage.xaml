<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anketa.MainPage"
             Title="Анкета гостя кофейни">

    <ScrollView>
        <Grid x:Name="MainGrid"
              Padding="20,16,20,32"
              RowSpacing="12"
              ColumnSpacing="12"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="Auto,*">

            <!-- Шапка -->
            <Image x:Name="LogoImage"
                   Grid.Row="0"
                   Grid.Column="0"
                   Source="coffee_cup.png"
                   Aspect="AspectFit"
                   HeightRequest="80"
                   WidthRequest="80"
                   Margin="0,0,4,0" />

            <VerticalStackLayout Grid.Row="0"
                                 Grid.Column="1"
                                 Spacing="4"
                                 VerticalOptions="Center">
                <Label x:Name="TitleLabel"
                       Text="Анкета гостя кофейни"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource CoffeeDark}" />
                <Label x:Name="SubtitleLabel"
                       Text="Помогите нам стать лучше — это займёт пару минут"
                       FontSize="14"
                       FontAttributes="Italic"
                       TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>

            <!-- Личные данные -->
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Личные данные"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,12,0,0"
                   TextColor="{StaticResource CoffeeDark}" />

            <Label Grid.Row="2"
                   Grid.Column="0"
                   Text="Имя *"
                   FontSize="14"
                   FontAttributes="None"
                   VerticalOptions="Center" />
            <Entry x:Name="NameEntry"
                   Grid.Row="2"
                   Grid.Column="1"
                   Placeholder="Как к вам обращаться?"
                   Keyboard="Text"
                   MaxLength="40" />

            <Label Grid.Row="3"
                   Grid.Column="0"
                   Text="Телефон *"
                   FontSize="14"
                   FontAttributes="None"
                   VerticalOptions="Center" />
            <Entry x:Name="PhoneEntry"
                   Grid.Row="3"
                   Grid.Column="1"
                   Placeholder="+7 900 000-00-00"
                   Keyboard="Telephone"
                   MaxLength="18" />

            <Label Grid.Row="4"
                   Grid.Column="0"
                   Text="Дата визита"
                   FontSize="14"
                   FontAttributes="None"
                   VerticalOptions="Center" />
            <DatePicker x:Name="VisitDatePicker"
                        Grid.Row="4"
                        Grid.Column="1"
                        Format="dd.MM.yyyy"
                        Date="10/18/2026"
                        MinimumDate="01/01/2025"
                        MaximumDate="12/31/2027" />

            <!-- Предпочтения -->
            <VerticalStackLayout Grid.Row="5"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Spacing="8"
                                 Margin="0,12,0,0">
                <Label Text="Ваши предпочтения"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource CoffeeDark}" />

                <Picker x:Name="DrinkPicker"
                        Title="Любимый напиток"
                        TitleColor="{StaticResource Gray500}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Эспрессо</x:String>
                            <x:String>Американо</x:String>
                            <x:String>Капучино</x:String>
                            <x:String>Латте</x:String>
                            <x:String>Раф</x:String>
                            <x:String>Чай</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="6"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Spacing="2">
                <Label Text="Как часто вы у нас бываете? *"
                       FontSize="14"
                       FontAttributes="None" />
                <RadioButton x:Name="FirstTimeRadio"
                             Content="Впервые"
                             GroupName="VisitFrequency"
                             Value="Впервые" />
                <RadioButton x:Name="MonthlyRadio"
                             Content="Пару раз в месяц"
                             GroupName="VisitFrequency"
                             Value="Пару раз в месяц" />
                <RadioButton x:Name="WeeklyRadio"
                             Content="Каждую неделю"
                             GroupName="VisitFrequency"
                             Value="Каждую неделю" />
                <RadioButton x:Name="DailyRadio"
                             Content="Почти каждый день"
                             GroupName="VisitFrequency"
                             Value="Почти каждый день" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="7"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Spacing="4">
                <Label Text="Что вы обычно берёте кроме напитков?"
                       FontSize="14"
                       FontAttributes="None" />
                <HorizontalStackLayout Spacing="6">
                    <CheckBox x:Name="DessertsCheckBox"
                              IsChecked="False"
                              Color="{StaticResource Coffee}" />
                    <Label Text="Десерты"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <CheckBox x:Name="BreakfastCheckBox"
                              IsChecked="False"
                              Color="{StaticResource Coffee}" />
                    <Label Text="Завтраки"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <CheckBox x:Name="TakeawayCheckBox"
                              IsChecked="True"
                              Color="{StaticResource Coffee}" />
                    <Label Text="Беру с собой"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
